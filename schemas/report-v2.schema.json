{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://detectra.it/schemas/report-v2.schema.json",
  "title": "Detection Threat Landscape report v2",
  "type": "object",
  "required": [
    "schema_version", "id", "title", "short_title", "subtitle", "published",
    "report_type", "classification", "maturity", "confidence", "operational_value",
    "primary_platform", "mitre", "decision", "key_findings", "source_facts",
    "analyst_assessment", "assumptions", "unknowns", "technical_background",
    "attack_chain", "telemetry", "query", "triage", "false_positives",
    "validation", "conclusion", "artwork"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "id": {"type": "string", "minLength": 6},
    "title": {"type": "string", "minLength": 8, "maxLength": 140},
    "short_title": {"type": "string", "minLength": 3, "maxLength": 60},
    "subtitle": {"type": "string", "minLength": 8, "maxLength": 180},
    "published": {"type": "string", "format": "date"},
    "report_type": {"enum": ["campaign", "cve", "malware", "behavior", "cloud-identity", "ot"]},
    "classification": {"enum": ["Detection concept", "Validation query", "Hunting query", "Production candidate"]},
    "maturity": {"enum": ["concept", "validation", "hunting", "production-candidate", "lab-validated", "production-validated"]},
    "confidence": {"enum": ["Low", "Medium", "High"]},
    "operational_value": {"type": "integer", "minimum": 1, "maximum": 10},
    "primary_platform": {"type": "string", "minLength": 3},
    "mitre": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decision": {"type": "string", "minLength": 20, "maxLength": 700},
    "key_findings": {"type": "array", "items": {"type": "string", "maxLength": 360}, "minItems": 3, "maxItems": 4},
    "source_facts": {"type": "array", "items": {"type": "string", "maxLength": 500}, "minItems": 1, "maxItems": 4},
    "analyst_assessment": {"type": "array", "items": {"type": "string", "maxLength": 500}, "minItems": 1, "maxItems": 4},
    "assumptions": {"type": "array", "items": {"type": "string", "maxLength": 420}, "minItems": 1, "maxItems": 4},
    "unknowns": {"type": "array", "items": {"type": "string", "maxLength": 420}, "minItems": 1, "maxItems": 4},
    "technical_background": {"type": "string", "minLength": 30, "maxLength": 1200},
    "attack_chain": {"type": "array", "minItems": 3, "maxItems": 6},
    "telemetry": {"type": "array", "minItems": 3, "maxItems": 9},
    "query": {"type": "object", "required": ["file", "language", "status", "logic", "match_proves", "match_does_not_prove"]},
    "triage": {"type": "array", "items": {"type": "string", "maxLength": 420}, "minItems": 4, "maxItems": 6},
    "false_positives": {"type": "array", "minItems": 1, "maxItems": 5},
    "validation": {"type": "object", "required": ["steps", "success", "rejection", "visibility_gaps", "promotion_gate"]},
    "conclusion": {"type": "string", "minLength": 30, "maxLength": 900},
    "artwork": {"type": "object", "required": ["kind", "label"]}
  },
  "additionalProperties": true
}
