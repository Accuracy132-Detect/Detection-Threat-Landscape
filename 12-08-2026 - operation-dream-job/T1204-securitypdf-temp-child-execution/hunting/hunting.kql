// Operation Dream Job / SecurityPDF child execution
// Classification: Hunting query - Untested implementation sketch
// Confidence: Medium
// Primary platform: Microsoft Defender XDR Advanced Hunting
// Required telemetry: Microsoft Defender for Endpoint process creation events
// Source evidence: Check Point Research observed SecurityPDF.exe writing and
// launching %TEMP%\new.exe after a crafted PDF was opened.
// No threshold, rarity, join, sequence, hash, domain, or attribution is used.

DeviceProcessEvents
| where InitiatingProcessFileName =~ "SecurityPDF.exe"
| where FileName =~ "new.exe"
| where FolderPath contains @"\Temp\"
| project
    Timestamp,
    DeviceId,
    DeviceName,
    AccountDomain,
    AccountName,
    AccountUpn,
    FileName,
    FolderPath,
    ProcessCommandLine,
    ProcessId,
    ProcessUniqueId,
    ProcessIntegrityLevel,
    ProcessTokenElevation,
    SHA1,
    InitiatingProcessFileName,
    InitiatingProcessFolderPath,
    InitiatingProcessCommandLine,
    InitiatingProcessId,
    InitiatingProcessUniqueId,
    InitiatingProcessAccountName,
    InitiatingProcessAccountUpn,
    IsProcessRemoteSession,
    ProcessRemoteSessionIP,
    ReportId
| order by Timestamp desc
