// Rule: [T1190][T1059] PHP2SHELL - Web PHP Suspicious Child
// MITRE ATT&CK: T1190, T1059
// Classification: Hunting query
// Status: Untested implementation sketch
// Primary platform: Microsoft Defender XDR
// Required telemetry: DeviceProcessEvents
// Purpose: Hunting query for web php suspicious child, with evidence boundaries and target-environment validation requirements
// Logic: Evaluate DeviceProcessEvents for web php suspicious child using the existing source-derived conditions while preserving projected investigation context.
// A match proves: A result proves that the published query conditions matched in DeviceProcessEvents; it is an investigative event, not a malicious verdict.
// A match does not prove: A match does NOT identify CVE-2026-109618/CVE-2026-109619, prove exploitation, or establish malicious intent.
// Expected false positives: authorized administration, approved software, testing, or benign artifact collisions.
// Coverage limits: local schema, field population, retention, collection scope, and attacker variation require validation.
// Evidence claims: C001, C002, C003
//
// Hunting query - Untested implementation sketch
// Purpose: surface a PHP/web-server process starting a shell or high-risk utility
// in a command shape consistent with post-exploitation after web RCE.
// A match does NOT identify CVE-2026-109618/CVE-2026-109619, prove exploitation,
// or establish malicious intent. Validate on Linux hosts onboarded to MDE.
DeviceProcessEvents
| where Timestamp > ago(7d)
| where InitiatingProcessFileName in~ ("apache2", "httpd", "nginx", "php-cgi")
    or InitiatingProcessFileName startswith "php-fpm"
    or InitiatingProcessFileName startswith "lsphp"
| where
    (
        FileName in~ ("bash", "dash", "sh", "zsh", "ksh")
        and ProcessCommandLine has_any
            ("/dev/tcp/", "base64 -d", "curl ", "wget ", "/etc/shadow",
             "mkfifo", "nc ", "socat", "whoami", "hostname", "uname -a")
    )
    or FileName in~ ("curl", "wget", "nc", "socat")
    or (
        FileName in~ ("python", "python3", "perl", "ruby", "node", "php")
        and ProcessCommandLine has_any (" -c ", " -e ", " -r ")
    )
| project Timestamp, DeviceId, DeviceName, AccountName,
          InitiatingProcessFileName, InitiatingProcessCommandLine,
          FileName, FolderPath, ProcessCommandLine, SHA1, ReportId
| order by Timestamp desc
