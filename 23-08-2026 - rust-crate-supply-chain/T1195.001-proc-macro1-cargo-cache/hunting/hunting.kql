// Rule: [T1195.001] Rust Crate Supply Chain - Proc MACRO1 Cargo Cache
// MITRE ATT&CK: T1195.001
// Classification: Hunting query
// Status: Untested implementation sketch
// Primary platform: Microsoft Defender XDR /
// Required telemetry: DeviceFileEvents
// Purpose: Retrospective hunt for officially listed compromised and attacker-owned crate artifacts on developer and CI systems.
// Logic: Evaluate DeviceFileEvents for proc macro1 cargo cache using the existing source-derived conditions while preserving projected investigation context.
// A match proves: An officially listed archive name was observed in a Cargo registry cache and requires dependency/build investigation.
// A match does not prove: Malicious build execution, payload launch, credential theft, persistence or attacker attribution.
// Expected false positives: authorized administration, approved software, testing, or benign artifact collisions.
// Coverage limits: local schema, field population, retention, collection scope, and attacker variation require validation.
// Evidence claims: C001, C002, C003
//
// Hunting query - Untested implementation sketch
// Primary platform: Microsoft Defender XDR / Advanced Hunting
// Required telemetry: Microsoft Defender for Endpoint file events on developer
// workstations and persistent or self-hosted CI runners.
// Evidence: the Rust Security Response Team recommends checking Cargo registry
// caches for these exact compromised versions and attacker-owned crate names.
DeviceFileEvents
| where FolderPath contains ".cargo"
    and FolderPath contains "registry"
    and FolderPath contains "cache"
| where
    FileName in~ (
        "arrayref-0.3.10.crate",
        "internment-0.8.7.crate",
        "append-only-vec-0.1.9.crate"
    )
    or (
        FileName endswith ".crate"
        and (
            FileName startswith "proc-macro1-"
            or FileName startswith "proc-macro-en-"
            or FileName startswith "aovine-"
            or FileName startswith "arone-"
            or FileName startswith "aronenao-"
            or FileName startswith "tinymember-"
        )
    )
| project
    Timestamp, DeviceId, DeviceName, ReportId, ActionType,
    FileName, FolderPath, PreviousFileName, PreviousFolderPath,
    FileSize, SHA1, SHA256, FileOriginUrl, FileOriginIP,
    InitiatingProcessAccountDomain, InitiatingProcessAccountName,
    InitiatingProcessAccountUpn, InitiatingProcessFileName,
    InitiatingProcessFolderPath, InitiatingProcessCommandLine,
    InitiatingProcessId, InitiatingProcessUniqueId
| order by Timestamp desc
