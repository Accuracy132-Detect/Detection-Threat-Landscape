// Rule: [T1566][T1027] Ascii Smuggling - Finance Envelope Fingerprint
// MITRE ATT&CK: T1566, T1027
// Classification: Hunting query
// Status: Untested implementation sketch
// Primary platform: Microsoft Defender XDR
// Required telemetry: EmailEvents, EmailDirection, EmailClusterId
// Purpose: Defender XDR hunt for the source-observed finance-themed header domain and marketing-platform envelope pattern. This is not body-content detection.
// Logic: Evaluate EmailEvents, EmailDirection, EmailClusterId for finance envelope fingerprint using the existing source-derived conditions while preserving projected investigation context.
// A match proves: A result proves that the published query conditions matched in EmailEvents, EmailDirection, EmailClusterId; it is an investigative event, not a malicious verdict.
// A match does not prove: successful exploitation, malicious ownership, downstream impact, campaign attribution or complete compromise without corroborating evidence.
// Expected false positives: authorized administration, approved software, testing, or benign artifact collisions.
// Coverage limits: local schema, field population, retention, collection scope, and attacker variation require validation.
// Evidence claims: C001, C002, C003
//
// ASCII-smuggling campaign infrastructure hunt
// Platform: Microsoft Defender XDR Advanced Hunting
// Classification: Hunting query - Untested implementation sketch
// Confidence: Medium
// Required telemetry: Defender for Office 365 EmailEvents
// Evidence: Microsoft Security Research, 2026-09-03, Query 1.
// Scope limitation: EmailEvents does not expose the message body. This query
// hunts the source-observed sender-domain fingerprint, not Unicode tag content.

// Finance/brand vocabulary the operator recombines into disposable domains.
let kwds = @"(capital|fund|hedge|express|solutions|choice|lend|growth|loan|loc|finance|business|pillar|advance|boost|catalyst|digital|direct|elevate|guardian|harbor|online|pulse|rocket|rush|united|wave|way|surge|swift|elite)";
EmailEvents
| where Timestamp > ago(30d)
| where EmailDirection == "Inbound"
// Header sender domain made of 3 or more adjacent finance/brand tokens.
| where SenderFromDomain matches regex strcat("(?i)", kwds, kwds, kwds)
// Envelope (MAIL FROM) shape: em-[digits] | acems[digits] | emsd[digits].
| where SenderMailFromDomain matches regex @"(?i)(em-|acems|emsd)\d"
| project Timestamp, NetworkMessageId, InternetMessageId,
          SenderFromAddress, SenderFromDomain,
          SenderMailFromAddress, SenderMailFromDomain,
          SenderIPv4, RecipientEmailAddress, Subject,
          DeliveryAction, DeliveryLocation, ThreatTypes,
          DetectionMethods, ConfidenceLevel, EmailClusterId
| sort by Timestamp desc
